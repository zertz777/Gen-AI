  "source": "FUNCTION_BLOCK FB_S07\nVAR_INPUT\n    BottleIn : BOOL;\n    FillDone : BOOL;\n    CapDone : BOOL;\n    PackDone : BOOL;\n    StartBtn : BOOL;\n    EStop_NC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Conveyor : BOOL;\n    FillValve : BOOL;\n    CapMotor : BOOL;\n    PackCyl : BOOL;\n    CycleCount : UINT;\n    Status : WORD;\nEND_VAR\nVAR\n    FirstScan : BOOL := TRUE;\n    StartBtnLast : BOOL := FALSE;\n    StartRising : BOOL := FALSE;\n    Running : BOOL := FALSE;\n    TimeoutLatched : BOOL := FALSE;\n    Step : INT := 0;\n    StepTime : UINT := 0;\nEND_VAR\n\n(* CONFLICT NOTICE:\n   K3 requires timeout to disable the current step output before a completion signal.\n   C6 would require FillValve to remain TRUE until FillDone.\n   This implementation applies the specified safety/timeout priority and C2 BottleIn interlock.\n   No external interface is added or changed.\n*)\n\nIF FirstScan THEN\n    Conveyor := FALSE;\n    FillValve := FALSE;\n    CapMotor := FALSE;\n    PackCyl := FALSE;\n    CycleCount := 0;\n    Status := 16#0000;\n    Step := 0;\n    Running := FALSE;\n    TimeoutLatched := FALSE;\n    StepTime := 0;\n    StartBtnLast := FALSE;\n    StartRising := FALSE;\n    FirstScan := FALSE;\nELSE\n    StartRising := StartBtn AND NOT StartBtnLast;\n    StartBtnLast := StartBtn;\n\n    IF NOT EStop_NC THEN\n        (* K5 / C1: emergency stop has highest priority *)\n        Conveyor := FALSE;\n        FillValve := FALSE;\n        CapMotor := FALSE;\n        PackCyl := FALSE;\n        Step := 0;\n        Running := FALSE;\n        TimeoutLatched := FALSE;\n        StepTime := 0;\n        Status := 16#8702;\n    ELSIF TimeoutLatched THEN\n        (* K3: hold current step, disable outputs, wait for manual handling *)\n        Conveyor := FALSE;\n        FillValve := FALSE;\n        CapMotor := FALSE;\n        PackCyl := FALSE;\n        Status := 16#8701;\n    ELSE\n        IF StartRising THEN\n            Running := TRUE;\n            Step := 0;\n            StepTime := 0;\n            TimeoutLatched := FALSE;\n            Status := 16#0000;\n        ELSIF Running THEN\n            StepTime := StepTime + 1;\n\n            CASE Step OF\n                0:\n                    IF BottleIn THEN\n                        Step := 1;\n                        StepTime := 0;\n                    END_IF;\n                1:\n                    (* C9: FillValve minimum 5 scan cycles = 100 ms;\n                       C6: keep FillValve until FillDone is present *)\n                    IF FillDone AND (StepTime >= 5) THEN\n                        Step := 2;\n                        StepTime := 0;\n                    END_IF;\n                2:\n                    IF CapDone THEN\n                        Step := 3;\n                        StepTime := 0;\n                    END_IF;\n                3:\n                    IF PackDone THEN\n                        IF CycleCount < UINT#65535 THEN\n                            CycleCount := CycleCount + 1;\n                        END_IF;\n                        Step := 0;\n                        StepTime := 0;\n                    END_IF;\n            END_CASE;\n\n            IF StepTime >= 250 THEN\n                TimeoutLatched := TRUE;\n                Status := 16#8701;\n            ELSE\n                Status := 16#0000;\n            END_IF;\n        ELSE\n            StepTime := 0;\n            Status := 16#0000;\n        END_IF;\n    END_IF;\n\n    (* K4: at most one actuator output is TRUE at any time *)\n    Conveyor := FALSE;\n    FillValve := FALSE;\n    CapMotor := FALSE;\n    PackCyl := FALSE;\n\n    IF EStop_NC AND Running AND NOT TimeoutLatched THEN\n        CASE Step OF\n            0:\n                Conveyor := TRUE;\n            1:\n                (* C2: FillValve requires BottleIn *)\n                IF BottleIn THEN\n                    FillValve := TRUE;\n                END_IF;\n            2:\n                CapMotor := TRUE;\n            3:\n                PackCyl := TRUE;\n        END_CASE;\n    END_IF;\nEND_IF;\nEND_FUNCTION_BLOCK\n",
