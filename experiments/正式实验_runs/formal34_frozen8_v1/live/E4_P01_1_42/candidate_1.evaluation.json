{
  "source": "FUNCTION_BLOCK FB_P01\nVAR_INPUT\n    bottleSensor : BOOL;\n    cleaningConfirmButton : BOOL;\n    fillingConfirmButton : BOOL;\n    cappingConfirmButton : BOOL;\n    packingConfirmButton : BOOL;\n    finishedButton : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Pump_Motor : BOOL := FALSE;\n    Filling_Valve : BOOL := FALSE;\n    Capping_Machine : BOOL := FALSE;\n    Packing_Machine : BOOL := FALSE;\n    Completion_Light : BOOL := FALSE;\nEND_VAR\nVAR\n    (* 0:等待瓶子; 1:清洗; 2:灌装; 3:封盖; 4:包装; 5:等待取瓶 *)\n    step : INT := 0;\n    initialized : BOOL := FALSE;\n\n    previousCleaning : BOOL := FALSE;\n    previousFilling : BOOL := FALSE;\n    previousCapping : BOOL := FALSE;\n    previousPacking : BOOL := FALSE;\n\n    cleaningRise : BOOL := FALSE;\n    fillingRise : BOOL := FALSE;\n    cappingRise : BOOL := FALSE;\n    packingRise : BOOL := FALSE;\nEND_VAR\n\n(* 每次调用对应一个20 ms扫描。\n   C9要求首次调用全部输出为FALSE，因此首次调用不启动清洗。\n   C3所给W公式在Filling_Valve为TRUE的当前拍已满足右操作数，\n   本身不能证明历史顺序；以下通过工步状态实现K1的顺序要求。\n   源码未声称经过编译或逐周期功能验证。 *)\n\ncleaningRise := cleaningConfirmButton AND NOT previousCleaning;\nfillingRise := fillingConfirmButton AND NOT previousFilling;\ncappingRise := cappingConfirmButton AND NOT previousCapping;\npackingRise := packingConfirmButton AND NOT previousPacking;\n\n(* 所有扫描均采样按钮，非当前工步的边沿不缓存。 *)\npreviousCleaning := cleaningConfirmButton;\npreviousFilling := fillingConfirmButton;\npreviousCapping := cappingConfirmButton;\npreviousPacking := packingConfirmButton;\n\nPump_Motor := FALSE;\nFilling_Valve := FALSE;\nCapping_Machine := FALSE;\nPacking_Machine := FALSE;\nCompletion_Light := FALSE;\n\nIF NOT initialized THEN\n    step := 0;\n    initialized := TRUE;\n\nELSIF finishedButton THEN\n    (* 最高运行优先级：当拍停止全部执行器、熄灯并复位。\n       按钮持续按下期间保持等待状态。 *)\n    step := 0;\n\nELSE\n    (* 每拍最多推进一个工步，避免同时确认导致跳步。 *)\n    CASE step OF\n        0:\n            IF bottleSensor THEN\n                step := 1;\n            END_IF;\n\n        1:\n            (* 瓶子离开时保持清洗工步，忽略该拍清洗确认。 *)\n            IF bottleSensor AND cleaningRise THEN\n                step := 2;\n            END_IF;\n\n        2:\n            IF fillingRise THEN\n                step := 3;\n            END_IF;\n\n        3:\n            IF cappingRise THEN\n                step := 4;\n            END_IF;\n\n        4:\n            IF packingRise THEN\n                step := 5;\n            END_IF;\n\n        5:\n            (* 完成状态保持至finishedButton有效。 *)\n            step := 5;\n\n    ELSE\n        (* 非法内部状态安全回到等待。 *)\n        step := 0;\n    END_CASE;\n\n    (* 根据推进后的工步输出，同拍停旧执行器并启动新执行器。 *)\n    CASE step OF\n        1:\n            Pump_Motor := bottleSensor;\n        2:\n            Filling_Valve := TRUE;\n        3:\n            Capping_Machine := TRUE;\n        4:\n            Packing_Machine := TRUE;\n        5:\n            Completion_Light := TRUE;\n    END_CASE;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n",
