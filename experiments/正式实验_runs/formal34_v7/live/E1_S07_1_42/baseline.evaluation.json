{
  "source": "FUNCTION_BLOCK FB_S07\nVAR_INPUT\n    BottleIn : BOOL;\n    FillDone : BOOL;\n    CapDone : BOOL;\n    PackDone : BOOL;\n    StartBtn : BOOL;\n    EStop_NC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Conveyor : BOOL;\n    FillValve : BOOL;\n    CapMotor : BOOL;\n    PackCyl : BOOL;\n    CycleCount : UINT;\n    Status : WORD;\nEND_VAR\n(* 内部状态/计时器；初态对应 initial_state *)\nVAR\n    Step : INT := 0;              (* 当前工步 0..3 *)\n    Run : BOOL := FALSE;          (* 整线运行标志 *)\n    StepTimer : UINT := 0;        (* 当前步已运行扫描周期数 *)\n    FillHold : UINT := 0;         (* 灌装阀已保持周期数（防抖） *)\n    StartBtnLast : BOOL := FALSE; (* 启动按钮上一扫描值（边沿检测） *)\n    StartRising : BOOL := FALSE;\n    Advance : BOOL := FALSE;\n    JustStarted : BOOL := FALSE;  (* 启动当周期不推进，避免同周期跳步 *)\nEND_VAR\nVAR CONSTANT\n    T_STEP_TIMEOUT : UINT := 250; (* 5 s / 20 ms 单步超时 *)\n    FILL_MIN_HOLD : UINT := 5;    (* 100 ms / 20 ms 灌装最小保持 *)\n    ST_OK : WORD := 16#0000;\n    ST_TIMEOUT : WORD := 16#8701;\n    ST_ESTOP : WORD := 16#8702;\nEND_VAR\n\n(* 默认输出全停（初态 / 非运行态 / C10 首周期无动作） *)\nConveyor := FALSE;\nFillValve := FALSE;\nCapMotor := FALSE;\nPackCyl := FALSE;\n\n(* 启动按钮上升沿检测（EStop 期间也跟踪，避免误触发） *)\nStartRising := StartBtn AND NOT StartBtnLast;\nStartBtnLast := StartBtn;\n\n(* K5 / C1：急停优先，立即全停并回到 Step 0，本扫描立即返回 *)\nIF NOT EStop_NC THEN\n    Run := FALSE;\n    Step := 0;\n    StepTimer := 0;\n    FillHold := 0;\n    Status := ST_ESTOP;\n    RETURN;\nEND_IF;\n\n(* 启动：上升沿且当前未运行（含超时停机后的重新启动） *)\nJustStarted := FALSE;\nIF StartRising AND NOT Run THEN\n    Run := TRUE;\n    Step := 0;\n    StepTimer := 0;\n    FillHold := 0;\n    Status := ST_OK;\n    JustStarted := TRUE;\nEND_IF;\n\nIF Run THEN\n    (* 工步输出：同一时刻仅一路动作（K4 / C4） *)\n    CASE Step OF\n        0: (* 进瓶工位 *)\n            Conveyor := TRUE;\n        1: (* 灌装：开阀前提瓶到位（C2） *)\n            IF BottleIn THEN\n                FillValve := TRUE;\n            END_IF;\n        2: (* 封盖 *)\n            CapMotor := TRUE;\n        3: (* 包装 *)\n            PackCyl := TRUE;\n    END_CASE;\n\n    (* 启动当周期只给输出、不推进计时，保证初态稳定 *)\n    IF NOT JustStarted THEN\n        (* 灌装最小保持计数（C9：≥100 ms 防抖） *)\n        IF (Step = 1) AND FillValve THEN\n            IF FillHold < 65535 THEN\n                FillHold := FillHold + 1;\n            END_IF;\n        ELSE\n            FillHold := 0;\n        END_IF;\n\n        (* 完成判定（K2） *)\n        Advance := FALSE;\n        CASE Step OF\n            0: Advance := BottleIn;\n            1: Advance := FillDone AND (FillHold >= FILL_MIN_HOLD);\n            2: Advance := CapDone;\n            3: Advance := PackDone;\n        END_CASE;\n\n        IF Advance THEN\n            (* 顺序推进 0→1→2→3→0（K1）；PackDone 回到 0 时计一瓶 *)\n            CASE Step OF\n                0: Step := 1;\n                1: Step := 2;\n                2: Step := 3;\n                3: Step := 0;\n                   CycleCount := CycleCount + 1;\n            END_CASE;\n            StepTimer := 0;\n            FillHold := 0;\n        ELSE\n            (* 单步计时与超时（K3） *)\n            IF StepTimer < 65535 THEN\n                StepTimer := StepTimer + 1;\n            END_IF;\n            IF StepTimer >= T_STEP_TIMEOUT THEN\n                Status := ST_TIMEOUT;\n                Conveyor := FALSE;\n                FillValve := FALSE;\n                CapMotor := FALSE;\n                PackCyl := FALSE;\n                Run := FALSE;          (* 停机，等待人工处理；Step 保持不变 *)\n                StepTimer := 0;\n                FillHold := 0;\n            END_IF;\n        END_IF;\n    END_IF;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n",
