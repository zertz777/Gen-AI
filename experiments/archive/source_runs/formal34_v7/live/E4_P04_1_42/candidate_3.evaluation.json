  "source": "FUNCTION_BLOCK FB_P04\nVAR_INPUT\n    VISCOSITY_OK : BOOL;\n    PASTE_E_STOP_NC : BOOL;\n    DebounceTime : TIME;\n    CycleTime : TIME;\nEND_VAR\nVAR_OUTPUT\n    VFD_RUN : BOOL := FALSE;\n    PUMP_MAINT_DUE : BOOL := FALSE;\n    PUMP_RUNTIME_ACC : LTIME := LTIME#0s;\nEND_VAR\nVAR\n    StartupScans : USINT := 0;\n    DebounceElapsed : TIME := T#0s;\n    ViscosityValid : BOOL := FALSE;\n    PreviousViscosityOK : BOOL := FALSE;\n    RuntimeStep : LTIME := LTIME#0s;\nEND_VAR\nVAR CONSTANT\n    MaintenanceThreshold : LTIME := LTIME#500h;\n    MaximumRuntime : LTIME := LTIME#9223372036854775807ns;\nEND_VAR\n\n(*\n    Requires a compile profile supporting LTIME, nanosecond literals\n    and TIME_TO_LTIME. Compilation and cycle tests remain outstanding.\n\n    Specification tension:\n    C7 requires the next scan to remain stopped after a FALSE viscosity\n    sample, even if a short DebounceTime permits revalidation on that\n    next scan. PreviousViscosityOK enforces that explicit restriction.\n    C10 G[0,1] is implemented as two initial stopped scans.\n*)\n\nVFD_RUN := FALSE;\n\nIF StartupScans < 2 THEN\n    IF StartupScans = 0 THEN\n        PUMP_RUNTIME_ACC := LTIME#0s;\n        PUMP_MAINT_DUE := FALSE;\n    END_IF;\n\n    DebounceElapsed := T#0s;\n    ViscosityValid := FALSE;\n    StartupScans := StartupScans + 1;\nELSE\n    IF NOT PASTE_E_STOP_NC\n        OR NOT VISCOSITY_OK\n        OR (DebounceTime <= T#0s)\n        OR (CycleTime <= T#0s)\n    THEN\n        (* Safety and invalid parameters immediately revoke permission. *)\n        DebounceElapsed := T#0s;\n        ViscosityValid := FALSE;\n    ELSE\n        IF NOT ViscosityValid THEN\n            IF DebounceElapsed >= DebounceTime THEN\n                ViscosityValid := TRUE;\n            ELSIF CycleTime >= (DebounceTime - DebounceElapsed) THEN\n                (* Clamp before adding to avoid TIME overflow. *)\n                DebounceElapsed := DebounceTime;\n                ViscosityValid := TRUE;\n            ELSE\n                DebounceElapsed := DebounceElapsed + CycleTime;\n            END_IF;\n        END_IF;\n\n        VFD_RUN := ViscosityValid AND PreviousViscosityOK;\n    END_IF;\n\n    IF VFD_RUN THEN\n        RuntimeStep := TIME_TO_LTIME(CycleTime);\n\n        (* Preserve runtime while stopped; saturate at the type boundary. *)\n        IF RuntimeStep >= (MaximumRuntime - PUMP_RUNTIME_ACC) THEN\n            PUMP_RUNTIME_ACC := MaximumRuntime;\n        ELSE\n            PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + RuntimeStep;\n        END_IF;\n    END_IF;\nEND_IF;\n\n(* Informational, latched indication: never participates in permission. *)\nIF PUMP_RUNTIME_ACC >= MaintenanceThreshold THEN\n    PUMP_MAINT_DUE := TRUE;\nEND_IF;\n\nPreviousViscosityOK := VISCOSITY_OK;\n\nEND_FUNCTION_BLOCK\n",
