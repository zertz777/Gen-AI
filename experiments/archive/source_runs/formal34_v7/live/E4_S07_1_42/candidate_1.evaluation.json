{
  "source": "FUNCTION_BLOCK FB_S07\nVAR_INPUT\n    BottleIn : BOOL;\n    FillDone : BOOL;\n    CapDone : BOOL;\n    PackDone : BOOL;\n    StartBtn : BOOL;\n    EStop_NC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Conveyor : BOOL := FALSE;\n    FillValve : BOOL := FALSE;\n    CapMotor : BOOL := FALSE;\n    PackCyl : BOOL := FALSE;\n    CycleCount : UINT := UINT#0;\n    Status : WORD := WORD#16#0000;\nEND_VAR\nVAR\n    Step : UINT := UINT#0;\n    StepTicks : UINT := UINT#0;\n    StartBtnLast : BOOL := FALSE;\n    StartRise : BOOL := FALSE;\n    Running : BOOL := FALSE;\n    TimeoutLatched : BOOL := FALSE;\n    StartupScans : UINT := UINT#0;\n    StartedThisScan : BOOL := FALSE;\n    StepComplete : BOOL := FALSE;\nEND_VAR\n\n(*\n需求原文：\n灌装线由进瓶、灌装、封盖、包装四个工位组成，按固定节拍顺序推进。\n1. StartBtn 上升沿启动整线，Conveyor = TRUE 进入进瓶工位；\n   EStop_NC = FALSE 时立即停止全部输出并回到 Step 0。\n2. 工步顺序：0 进瓶（等 BottleIn）→ 1 灌装（FillValve 开，等 FillDone）\n   → 2 封盖（CapMotor 开，等 CapDone）→ 3 包装（PackCyl 开，等 PackDone）\n   → 回到 0。\n3. 每一步自进入起计时，超过 5 s 未收到完成信号则置 Status = 16#8701、\n   保持当前步不动、关闭该步输出（等待人工处理）。\n4. 每完成一瓶（PackDone 且回到 Step 0）CycleCount 加 1。\n5. 同一时刻四个执行器输出中最多一个为 TRUE。\n6. Status：16#0000 正常、16#8701 工步超时、16#8702 急停。\n扫描周期：20 ms。\n\n保留的形式化规约：\nC1: G(!EStop_NC -> (!Conveyor && !FillValve && !CapMotor && !PackCyl))\nC2: G(FillValve -> BottleIn)\nC4: G(!(Conveyor && FillValve) && !(Conveyor && CapMotor) &&\n      !(Conveyor && PackCyl) && !(FillValve && CapMotor) &&\n      !(FillValve && PackCyl) && !(CapMotor && PackCyl))\nC6: G(FillValve -> (FillValve W FillDone))\nC9: G(FillValve -> G[0,5](FillValve))\nC10: G[0,1](!Conveyor && !FillValve && !CapMotor && !PackCyl)\n\n语义冲突报告，待审；本实现不宣称满足全部形式化规约：\n- C9 对每个 FillValve=TRUE 的周期重新要求未来五周期仍为 TRUE，\n  并非仅要求进入灌装后保持 100 ms；在无限轨迹上它禁止灌装阀关闭。\n  因此它与正常完成关阀、超时关阀及急停关阀冲突。\n  本实现保留原文完成推进和安全关断，不将 C9 暗改为进入时的最短保持。\n- C6 没有急停或超时例外；FillDone 未出现时，C6 与原文关断要求冲突。\n- BottleIn 在灌装期间变为 FALSE 且 FillDone 未出现时，\n  C2 要求关阀，C6 要求保持开阀。本实现优先 C2，工步仍保持灌装步。\n- C10 的 [0,1] 为前两个扫描周期；若首扫描出现启动上升沿，\n  它与原文立即启动动作冲突。本实现接受启动但将输出抑制到第三扫描。\n- 超时人工处理的解除条件未给出；不增设复位接口，也不赋予 StartBtn\n  超时复位功能。超时保持，现有急停复位路径清除超时。\n- UINT 计数达到 65535 后不能继续精确表示加 1；采用饱和保持，\n  不回绕、不新增状态码。满量程后的计数需求待审。\n\n计时约定：\n进入工步的扫描置 StepTicks=0，随后每次调用累计一个 20 ms 周期。\n250 周期为 5 s；严格“超过 5 s”在第 251 周期判定。\n对应完成信号在本次判定中为 TRUE 时优先正常推进。\n初始两个扫描周期不计入尚未执行的工步时间。\n未声称经过编译或逐周期验证。\n*)\n\nStartRise := StartBtn AND NOT StartBtnLast;\nStartBtnLast := StartBtn;\nStartedThisScan := FALSE;\nStepComplete := FALSE;\n\n(* 每次调用先关断，最后只为当前有效工步开启一路输出。 *)\nConveyor := FALSE;\nFillValve := FALSE;\nCapMotor := FALSE;\nPackCyl := FALSE;\n\n(* 上电抑制仅在功能块生命周期最初两个调用有效。 *)\nIF StartupScans < UINT#2 THEN\n    StartupScans := StartupScans + UINT#1;\n\n    IF NOT EStop_NC THEN\n        Running := FALSE;\n        TimeoutLatched := FALSE;\n        Step := UINT#0;\n        StepTicks := UINT#0;\n        Status := WORD#16#8702;\n    ELSE\n        Status := WORD#16#0000;\n        IF StartRise THEN\n            Running := TRUE;\n            Step := UINT#0;\n            StepTicks := UINT#0;\n        END_IF;\n    END_IF;\n\nELSE\n    (* 急停最高优先级；此分支后不执行任何工步处理。 *)\n    IF NOT EStop_NC THEN\n        Running := FALSE;\n        TimeoutLatched := FALSE;\n        Step := UINT#0;\n        StepTicks := UINT#0;\n        Status := WORD#16#8702;\n\n    ELSIF TimeoutLatched THEN\n        (* 所有完成信号和启动沿均不能解除超时保持。 *)\n        Status := WORD#16#8701;\n\n    ELSE\n        Status := WORD#16#0000;\n\n        IF NOT Running AND StartRise THEN\n            Running := TRUE;\n            Step := UINT#0;\n            StepTicks := UINT#0;\n            StartedThisScan := TRUE;\n        END_IF;\n\n        IF Running THEN\n            (* 启动当扫描先输出进瓶，不在同扫描跨越第一工步。 *)\n            IF NOT StartedThisScan THEN\n                CASE Step OF\n                    UINT#0:\n                        StepComplete := BottleIn;\n                    UINT#1:\n                        StepComplete := FillDone;\n                    UINT#2:\n                        StepComplete := CapDone;\n                    UINT#3:\n                        StepComplete := PackDone;\n                END_CASE;\n\n                IF StepComplete THEN\n                    CASE Step OF\n                        UINT#0:\n                            Step := UINT#1;\n                        UINT#1:\n                            Step := UINT#2;\n                        UINT#2:\n                            Step := UINT#3;\n                        UINT#3:\n                            Step := UINT#0;\n                            IF CycleCount < UINT#65535 THEN\n                                CycleCount := CycleCount + UINT#1;\n                            END_IF;\n                    END_CASE;\n                    StepTicks := UINT#0;\n                ELSE\n                    IF StepTicks < UINT#251 THEN\n                        StepTicks := StepTicks + UINT#1;\n                    END_IF;\n\n                    IF StepTicks > UINT#250 THEN\n                        TimeoutLatched := TRUE;\n                        Status := WORD#16#8701;\n                    END_IF;\n                END_IF;\n            END_IF;\n\n            IF NOT TimeoutLatched THEN\n                CASE Step OF\n                    UINT#0:\n                        Conveyor := TRUE;\n                    UINT#1:\n                        (* 保持 C2 的实时瓶到位联锁，不写只读输入。 *)\n                        FillValve := BottleIn;\n                    UINT#2:\n                        CapMotor := TRUE;\n                    UINT#3:\n                        PackCyl := TRUE;\n                END_CASE;\n            END_IF;\n        END_IF;\n    END_IF;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n",
