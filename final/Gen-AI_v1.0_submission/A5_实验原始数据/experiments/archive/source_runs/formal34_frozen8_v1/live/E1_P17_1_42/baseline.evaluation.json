{
  "source": "TYPE ST_Recipe :\nSTRUCT\n    recipeID : INT;\n    ingredientType : INT;\n    ingredientRatio : REAL;\n    productionTemperature : REAL;\nEND_STRUCT\nEND_TYPE\nFUNCTION_BLOCK FB_P17\nVAR_INPUT\n    addRecipe : BOOL;\n    deleteRecipe : BOOL;\n    modifyRecipe : BOOL;\n    queryRecipe : BOOL;\n    recipeIn : ST_Recipe;\nEND_VAR\nVAR_OUTPUT\n    recipeAdded : BOOL;\n    recipeDeleted : BOOL;\n    recipeModified : BOOL;\n    recipeQueryResult : ST_Recipe;\n    error : BOOL;\n    status : WORD;\nEND_VAR\nVAR_IN_OUT\n    recipe : ARRAY[1..10] OF ST_Recipe;\nEND_VAR\nVAR\n    i : INT;\n    found : BOOL;\n    slot : INT;\nEND_VAR\n\n(* Success indicators are single-cycle pulses; error/status are held until the next request. *)\nrecipeAdded := FALSE;\nrecipeDeleted := FALSE;\nrecipeModified := FALSE;\n\n(* Add: duplicate id -> 16#8002; full -> 16#8003; else write smallest empty slot. *)\nIF addRecipe THEN\n    error := FALSE;\n    status := 16#0000;\n    found := FALSE;\n    FOR i := 1 TO 10 DO\n        IF (recipe[i].recipeID <> 0) AND (recipe[i].recipeID = recipeIn.recipeID) THEN\n            found := TRUE;\n        END_IF\n    END_FOR\n    IF found THEN\n        error := TRUE;\n        status := 16#8002;\n    ELSE\n        slot := 0;\n        FOR i := 1 TO 10 DO\n            IF (recipe[i].recipeID = 0) AND (slot = 0) THEN\n                slot := i;\n            END_IF\n        END_FOR\n        IF slot = 0 THEN\n            error := TRUE;\n            status := 16#8003;\n        ELSE\n            recipe[slot] := recipeIn;\n            recipeAdded := TRUE;\n        END_IF\n    END_IF\n\n(* Delete: clear matching slot; not found -> 16#8004. *)\nELSIF deleteRecipe THEN\n    error := FALSE;\n    status := 16#0000;\n    found := FALSE;\n    FOR i := 1 TO 10 DO\n        IF (recipe[i].recipeID <> 0) AND (recipe[i].recipeID = recipeIn.recipeID) THEN\n            found := TRUE;\n            recipe[i].recipeID := 0;\n        END_IF\n    END_FOR\n    IF found THEN\n        recipeDeleted := TRUE;\n    ELSE\n        error := TRUE;\n        status := 16#8004;\n    END_IF\n\n(* Modify: replace matching slot; not found -> 16#8005. *)\nELSIF modifyRecipe THEN\n    error := FALSE;\n    status := 16#0000;\n    found := FALSE;\n    FOR i := 1 TO 10 DO\n        IF (recipe[i].recipeID <> 0) AND (recipe[i].recipeID = recipeIn.recipeID) THEN\n            found := TRUE;\n            recipe[i] := recipeIn;\n        END_IF\n    END_FOR\n    IF found THEN\n        recipeModified := TRUE;\n    ELSE\n        error := TRUE;\n        status := 16#8005;\n    END_IF\n\n(* Query: output matching recipe; not found -> 16#8001. *)\nELSIF queryRecipe THEN\n    error := FALSE;\n    status := 16#0000;\n    found := FALSE;\n    FOR i := 1 TO 10 DO\n        IF (recipe[i].recipeID <> 0) AND (recipe[i].recipeID = recipeIn.recipeID) THEN\n            found := TRUE;\n            recipeQueryResult := recipe[i];\n        END_IF\n    END_FOR\n    IF NOT found THEN\n        error := TRUE;\n        status := 16#8001;\n    END_IF\nEND_IF\n\nEND_FUNCTION_BLOCK\n",
