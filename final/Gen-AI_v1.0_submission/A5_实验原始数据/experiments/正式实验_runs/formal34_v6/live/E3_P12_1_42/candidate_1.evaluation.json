{
  "source": "FUNCTION_BLOCK FB_P12\nVAR_INPUT\n    THICKNESS_FAULT : BOOL;\n    THICKNESS_SIGNAL_VALID : BOOL;\n    CUTTING_RUN : BOOL;\n    FaultTimestamp : DINT;\n    CycleTime : TIME;\nEND_VAR\nVAR_OUTPUT\n    THICKNESS_ALARM : BOOL;\n    Slab_Fault_Counter : UINT;\n    Slab_Runtime_Accumulator : LTIME;\n    Slab_Fault_History : ARRAY[0..4] OF DINT;\nEND_VAR\nVAR\n    initDone : BOOL := FALSE;\n    prev_fault : BOOL := FALSE;\n    holdElapsed : LTIME := LTIME#0s;\n    alarmHoldActive : BOOL := FALSE;\n    i : INT;\n    cycleLTIME : LTIME;\n    validFaultEdge : BOOL;\nEND_VAR\n\n// Power-up initialization\nIF NOT initDone THEN\n    Slab_Fault_Counter := 0;\n    Slab_Runtime_Accumulator := LTIME#0s;\n    FOR i := 0 TO 4 DO\n        Slab_Fault_History[i] := 0;\n    END_FOR;\n    THICKNESS_ALARM := FALSE;\n    holdElapsed := LTIME#0s;\n    alarmHoldActive := FALSE;\n    prev_fault := THICKNESS_FAULT;\n    initDone := TRUE;\nELSE\n    // Normal scan\n    IF NOT THICKNESS_SIGNAL_VALID THEN\n        THICKNESS_ALARM := FALSE;\n        alarmHoldActive := FALSE;\n        holdElapsed := LTIME#0s;\n        prev_fault := THICKNESS_FAULT;\n    ELSE\n        // Signal valid\n        validFaultEdge := THICKNESS_FAULT AND NOT prev_fault;\n\n        // Fault rising edge: count and record history\n        IF validFaultEdge THEN\n            IF Slab_Fault_Counter < 65535 THEN\n                Slab_Fault_Counter := Slab_Fault_Counter + 1;\n            END_IF;\n            FOR i := 4 TO 1 BY -1 DO\n                Slab_Fault_History[i] := Slab_Fault_History[i-1];\n            END_FOR;\n            Slab_Fault_History[0] := FaultTimestamp;\n            holdElapsed := LTIME#0s;\n            alarmHoldActive := TRUE;\n        END_IF;\n\n        // Fault present keeps alarm and hold active\n        IF THICKNESS_FAULT THEN\n            alarmHoldActive := TRUE;\n        END_IF;\n\n        // Determine alarm output\n        THICKNESS_ALARM := THICKNESS_FAULT OR (alarmHoldActive AND holdElapsed < LTIME#500ms);\n\n        // Deactivate hold if expired and no fault\n        IF alarmHoldActive AND NOT THICKNESS_FAULT AND holdElapsed >= LTIME#500ms THEN\n            alarmHoldActive := FALSE;\n        END_IF;\n\n        // Accumulate hold elapsed for next scan\n        IF alarmHoldActive THEN\n            IF CycleTime > T#0s THEN\n                cycleLTIME := TIME_TO_LTIME(CycleTime);\n                holdElapsed := holdElapsed + cycleLTIME;\n                IF holdElapsed > LTIME#500ms THEN\n                    holdElapsed := LTIME#500ms;\n                END_IF;\n            END_IF;\n        END_IF;\n\n        // Accumulate normal-cutting runtime\n        IF CUTTING_RUN AND NOT THICKNESS_FAULT THEN\n            IF CycleTime > T#0s THEN\n                Slab_Runtime_Accumulator := Slab_Runtime_Accumulator + TIME_TO_LTIME(CycleTime);\n            END_IF;\n        END_IF;\n\n        prev_fault := THICKNESS_FAULT;\n    END_IF;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n",
