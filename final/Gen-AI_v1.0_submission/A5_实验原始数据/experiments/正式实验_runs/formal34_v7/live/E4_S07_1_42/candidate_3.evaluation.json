{
  "source": "FUNCTION_BLOCK FB_S07\nVAR_INPUT\n    BottleIn : BOOL;\n    FillDone : BOOL;\n    CapDone : BOOL;\n    PackDone : BOOL;\n    StartBtn : BOOL;\n    EStop_NC : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Conveyor : BOOL := FALSE;\n    FillValve : BOOL := FALSE;\n    CapMotor : BOOL := FALSE;\n    PackCyl : BOOL := FALSE;\n    CycleCount : UINT := UINT#0;\n    Status : WORD := WORD#16#0000;\nEND_VAR\nVAR\n    Step : UINT := UINT#0;\n    StepTicks : UINT := UINT#0;\n    StartBtnLast : BOOL := FALSE;\n    StartRise : BOOL := FALSE;\n    Running : BOOL := FALSE;\n    TimeoutLatched : BOOL := FALSE;\n    StartupScans : UINT := UINT#0;\n    StartPending : BOOL := FALSE;\n    StartedThisScan : BOOL := FALSE;\n    StepComplete : BOOL := FALSE;\nEND_VAR\n\n(*\n需求冲突报告（原条款保留，不能宣称全部同时满足）：\n1. C6 要求 FillValve 保持至 FillDone；急停 C1/K5 和超时 K3\n   均要求即使 FillDone 未出现也关闭。这里急停、超时优先。\n2. C2 要求 FillValve -> BottleIn；灌装期间 BottleIn 消失时，\n   C2 与 C6 的无条件保持也冲突。这里关闭阀，不跳步，计时继续。\n3. C9 原式 G(FillValve -> G[0,5](FillValve)) 是逐周期滚动要求，\n   并非仅在进入灌装时保持 100 ms。一旦开阀，该式会持续要求\n   后续保持，无法与完成关阀、急停及超时同时满足。\n   不将原式暗中改写为最短动作时间；此冲突仍待审。\n4. C10 原式限制最初两个扫描输出为 FALSE，与这两个扫描内\n   StartBtn 上升沿立即开启 Conveyor 冲突。这里执行启动保护，\n   暂存启动沿，保护结束后启动；急停取消暂存命令。\n5. 超时的人工处理方式未定义且没有复位接口。StartBtn 不清除\n   超时锁存；仅急停执行题面要求的 Step 0 复位，之后须新启动沿。\n6. CycleCount 达 UINT 上限时饱和，避免溢出回零；超出可表示范围\n   时无法继续表达每瓶加一，该边界行为待审。\n\n每次调用为 20 ms；进入工步时 StepTicks=0。\n250 个间隔为 5 s，251 个间隔才满足“超过 5 s”。\n完成信号与超时同周期出现时，完成优先。\n本源码未声称经过真实编译或逐周期功能验证。\n*)\n\nStartRise := StartBtn AND NOT StartBtnLast;\nStartBtnLast := StartBtn;\n\nConveyor := FALSE;\nFillValve := FALSE;\nCapMotor := FALSE;\nPackCyl := FALSE;\nStartedThisScan := FALSE;\nStepComplete := FALSE;\n\n(* 上电保护计数独立于急停；前两个调用禁止执行器动作。 *)\nIF StartupScans < UINT#2 THEN\n    StartupScans := StartupScans + UINT#1;\n\n    IF NOT EStop_NC THEN\n        Running := FALSE;\n        TimeoutLatched := FALSE;\n        StartPending := FALSE;\n        Step := UINT#0;\n        StepTicks := UINT#0;\n        Status := WORD#16#8702;\n    ELSE\n        Status := WORD#16#0000;\n        IF StartRise THEN\n            StartPending := TRUE;\n        END_IF;\n    END_IF;\n\nELSE\n    (* 急停为最高优先级；不执行本扫描其余工步逻辑。 *)\n    IF NOT EStop_NC THEN\n        Running := FALSE;\n        TimeoutLatched := FALSE;\n        StartPending := FALSE;\n        Step := UINT#0;\n        StepTicks := UINT#0;\n        Status := WORD#16#8702;\n\n    ELSE\n        IF TimeoutLatched THEN\n            Status := WORD#16#8701;\n            StartPending := FALSE;\n\n        ELSE\n            Status := WORD#16#0000;\n\n            IF NOT Running AND (StartRise OR StartPending) THEN\n                Running := TRUE;\n                Step := UINT#0;\n                StepTicks := UINT#0;\n                StartedThisScan := TRUE;\n            END_IF;\n            StartPending := FALSE;\n\n            IF Running THEN\n                (* 启动扫描只进入进瓶，不在同扫描跨越工步。 *)\n                IF NOT StartedThisScan THEN\n                    IF StepTicks < UINT#251 THEN\n                        StepTicks := StepTicks + UINT#1;\n                    END_IF;\n\n                    CASE Step OF\n                        UINT#0:\n                            StepComplete := BottleIn;\n                        UINT#1:\n                            StepComplete := FillDone;\n                        UINT#2:\n                            StepComplete := CapDone;\n                        UINT#3:\n                            StepComplete := PackDone;\n                    END_CASE;\n\n                    IF StepComplete THEN\n                        CASE Step OF\n                            UINT#0:\n                                Step := UINT#1;\n                            UINT#1:\n                                Step := UINT#2;\n                            UINT#2:\n                                Step := UINT#3;\n                            UINT#3:\n                                Step := UINT#0;\n                                IF CycleCount < UINT#65535 THEN\n                                    CycleCount := CycleCount + UINT#1;\n                                END_IF;\n                        END_CASE;\n                        StepTicks := UINT#0;\n\n                    ELSIF StepTicks > UINT#250 THEN\n                        TimeoutLatched := TRUE;\n                        Status := WORD#16#8701;\n                        (* 保持 Step、计时值及运行状态，禁止全部执行器。 *)\n                    END_IF;\n                END_IF;\n\n                (* 根据最终工步统一译码，避免转换扫描出现双输出。 *)\n                IF NOT TimeoutLatched THEN\n                    CASE Step OF\n                        UINT#0:\n                            Conveyor := TRUE;\n                        UINT#1:\n                            FillValve := BottleIn;\n                        UINT#2:\n                            CapMotor := TRUE;\n                        UINT#3:\n                            PackCyl := TRUE;\n                    END_CASE;\n                END_IF;\n            END_IF;\n        END_IF;\n    END_IF;\nEND_IF;\n\nEND_FUNCTION_BLOCK\n",
