{
  "source": "FUNCTION_BLOCK FB_P18\nVAR_INPUT\n    enqueue : BOOL;\n    dequeue : BOOL;\n    reset : BOOL;\nEND_VAR\nVAR_OUTPUT\n    elementCount : DINT := 0;\n    status : WORD := WORD#16#0000;\nEND_VAR\nVAR_IN_OUT\n    item : INT;\n    buffer : ARRAY[*] OF INT;\nEND_VAR\nVAR\n    prevEnqueue : BOOL := FALSE;\n    prevDequeue : BOOL := FALSE;\n    head : DINT := 0;\n    tail : DINT := 0;\n    count : DINT := 0;\n    capacity : DINT;\n    lowerBound : DINT;\n    idx : DINT;\nEND_VAR\n\n// Derive queue capacity from the actual length of the caller-supplied buffer\ncapacity := UPPER_BOUND(buffer, 1) - LOWER_BOUND(buffer, 1) + 1;\nlowerBound := LOWER_BOUND(buffer, 1);\n\n// Reset takes priority over enqueue and dequeue\nIF reset THEN\n    head := 0;\n    tail := 0;\n    count := 0;\n    elementCount := 0;\n    status := WORD#16#0000;\nELSIF enqueue AND NOT prevEnqueue THEN\n    IF count >= capacity THEN\n        status := WORD#16#8002; // enqueue rejected: queue full\n    ELSE\n        idx := lowerBound + tail;\n        buffer[idx] := item;\n        tail := tail + 1;\n        IF tail >= capacity THEN\n            tail := 0;\n        END_IF;\n        count := count + 1;\n        status := WORD#16#0000;\n    END_IF;\n    elementCount := count;\nELSIF dequeue AND NOT prevDequeue THEN\n    IF count <= 0 THEN\n        status := WORD#16#8001; // dequeue rejected: queue empty\n    ELSE\n        idx := lowerBound + head;\n        item := buffer[idx];\n        head := head + 1;\n        IF head >= capacity THEN\n            head := 0;\n        END_IF;\n        count := count - 1;\n        status := WORD#16#0000;\n    END_IF;\n    elementCount := count;\nELSE\n    elementCount := count;\n    status := WORD#16#0000;\nEND_IF;\n\n// Update edge detection memory for next invocation\nprevEnqueue := enqueue;\nprevDequeue := dequeue;\n\nEND_FUNCTION_BLOCK\n",
